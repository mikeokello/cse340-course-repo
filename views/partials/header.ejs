<!DOCTYPE html>
<html lang="en">
<head>
  <meta charset="UTF-8">
  <meta name="viewport" content="width=device-width, initial-scale=1.0">
  <title><%= title %> | CSE 340</title>
  <link rel="stylesheet" href="/css/styles.css">
</head>
<body>
  <header>
    <nav class="navbar">
      <div class="nav-brand">
        <a href="/">CSE 340 Site</a>
      </div>
      <ul class="nav-links">
        <li><a href="/">Home</a></li>
        <li><a href="/organizations">Organizations</a></li>
        <li><a href="/projects">Service Projects</a></li>
        <li><a href="/categories">Categories</a></li>
        <% if (user) { %>
          <li><a href="/dashboard">Dashboard</a></li>
          <% if (user.userRole === 'admin') { %>
            <li><a href="/users">Users</a></li>
          <% } %>
          <li><a href="/logout">Logout</a></li>
        <% } else { %>
          <li><a href="/login">Login</a></li>
          <li><a href="/register">Register</a></li>
        <% } %>
      </ul>
    </nav>
  </header>

  <!-- Global Messages Display -->
  <% if (messages && messages.length > 0) { %>
    <div class="messages-container">
      <% messages.forEach(msg => { %>
        <% var msgType = (typeof msg === 'object' && msg.type) ? msg.type : 'info'; %>
        <% var msgText = (typeof msg === 'object' && msg.text) ? msg.text : msg; %>
        <div class="alert alert-<%= msgType %>">
          <%= msgText %>
          <button type="button" class="close-alert" onclick="this.parentElement.style.display='none';">&times;</button>
        </div>
      <% }); %>
    </div>
  <% } %>

  <main class="container">