<%- include('partials/header') %>
<main>
    <h1><%= title %></h1>
    <section class="category-list">
        <ul>
            <% categories.forEach(category => { %>
                <li class="category-item">
                    <a href="/category/<%= category.category_id %>"><%= category.name %></a>
                </li>
            <% }) %>
        </ul>
    </section>
</main>
<%- include('partials/footer') %>