<%- include('partials/header') %>

<main>
    <h1><%= title %></h1>
    <h2><%= projectDetails.title %></h2>
    <p><strong>Organization:</strong> <a href="/organization/<%= projectDetails.organization_id %>"><%= projectDetails.organization_name %></a></p>
    <p><strong>Description:</strong> <%= projectDetails.description %></p>
    <p><strong>Location:</strong> <%= projectDetails.location %></p>

    <% if (projectDetails.categories && projectDetails.categories.length > 0) { %>
        <p>
            <strong>Categories:</strong>
            <% projectDetails.categories.forEach((category, index) => { %>
                <a href="/category/<%= category.category_id %>"><%= category.name %></a><% if (index < projectDetails.categories.length - 1) { %>, <% } %>
            <% }) %>
        </p>
    <% } %>

    <!-- Volunteer Section -->
    <% if (user) { %>
        <div style="margin-top: 2rem; padding: 1rem; background-color: #f0f0f0; border-radius: 5px;">
            <% if (isVolunteer) { %>
                <p><strong style="color: green;">✓ You are volunteering for this project</strong></p>
                <form action="/unvolunteer/<%= projectDetails.project_id %>" method="POST" style="display: inline;">
                    <button type="submit" class="btn btn-danger">Remove as Volunteer</button>
                </form>
            <% } else { %>
                <p>Interested in volunteering?</p>
                <form action="/volunteer/<%= projectDetails.project_id %>" method="POST" style="display: inline;">
                    <button type="submit" class="btn btn-success">Volunteer for This Project</button>
                </form>
            <% } %>
        </div>
    <% } %>

    <div style="margin-top: 2rem; display: flex; gap: 1rem;">
        <% if (user && user.userRole === 'admin') { %>
            <a href="/edit-project/<%= projectDetails.project_id %>" class="btn btn-primary">Edit Project</a>
            <a href="/assign-categories/<%= projectDetails.project_id %>" class="btn btn-secondary">Assign Categories</a>
        <% } %>
        <a href="/projects" class="btn btn-secondary">Back to Projects</a>
    </div>
</main>

<%- include('partials/footer') %>