<%- include('partials/header') %>

<h1><%= title %></h1>
<section class="grid">
  <% if (projects && projects.length > 0) { %>
    <% projects.forEach(project => { %>
      <div class="card project-card">
        <h2><%= project.title %></h2>
        <p class="organization">🏢 <strong><%= project.organization_name %></strong></p>
        <p class="description"><%= project.description %></p>
        <p class="location">📍 <strong>Location:</strong> <%= project.location %></p>
        <% if (project.categories) { %>
          <p class="categories"><strong>Categories:</strong> <%= project.categories %></p>
        <% } %>
      </div>
    <% }) %>
  <% } else { %>
    <p>No projects found.</p>
  <% } %>
</section>

<%- include('partials/footer') %>