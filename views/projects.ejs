<%- include('partials/header') %>
<main>
    <div style="display: flex; justify-content: space-between; align-items: center; margin-bottom: 2rem;">
        <h1><%= title %></h1>
        <a href="/new-project" class="btn btn-primary">+ Create Project</a>
    </div>
    <section class="grid">
        <% if (projects && projects.length > 0) { %>
            <% projects.forEach(project => { %>
                <div class="card project-card">
                    <h2><a href="/project/<%= project.project_id %>"><%= project.title %></a></h2>
                    <p class="organization">🏢 <strong><a href="/organization/<%= project.organization_id %>"><%= project.organization_name %></a></strong></p>
                    <p class="description"><%= project.description %></p>
                    <p class="location">📍 <strong>Location:</strong> <%= project.location %></p>
                    <% if (project.categories) { %>
                        <p class="categories"><strong>Categories:</strong> <%= project.categories %></p>
                    <% } %>
                </div>
            <% }) %>
        <% } else { %>
            <p>No projects found.</p>
        <% } %>
    </section>
</main>
<%- include('partials/footer') %>