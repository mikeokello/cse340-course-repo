<%- include('partials/header') %>
<main>
    <h1><%= title %></h1>
    <section class="grid">
        <% if (organizations && organizations.length > 0) { %>
            <% organizations.forEach(org => { %>
                <div class="card">
                    <img src="/images/<%= org.logo_filename %>" alt="<%= org.name %> logo" class="org-logo">
                    <h2><a href="/organization/<%= org.organization_id %>"><%= org.name %></a></h2>
                    <p><%= org.description %></p>
                    <p class="contact-email">📧 <a href="mailto:<%= org.contact_email %>"><%= org.contact_email %></a></p>
                </div>
            <% }) %>
        <% } else { %>
            <p>No organizations found.</p>
        <% } %>
    </section>
</main>
<%- include('partials/footer') %>