<%- include('partials/header') %>
<main class="container">
    <h1><%= title %></h1>

    <% if (errors && errors.length > 0) { %>
        <div class="error-container" style="border-left-color: var(--danger);">
            <ul>
                <% errors.forEach(error => { %>
                    <li><%= error %></li>
                <% }) %>
            </ul>
        </div>
    <% } %>

    <form action="<%= action %>" method="POST" class="card" style="max-width: 600px;" id="categoryForm">
        <div style="margin-bottom: 1rem;">
            <label for="name" style="display: block; margin-bottom: 0.5rem; font-weight: 600;">Category Name <span style="color: red;">*</span></label>
            <input
                type="text"
                id="name"
                name="name"
                value="<%= formData.name || '' %>"
                required
                minlength="1"
                maxlength="100"
                placeholder="Enter category name"
                title="Category name must be 1-100 characters"
            >
            <small style="color: var(--text-light);">Max 100 characters</small>
        </div>

        <div style="display: flex; gap: 1rem;">
            <button type="submit" class="btn btn-primary"><%= submitText %></button>
            <a href="/categories" class="btn btn-secondary">Cancel</a>
        </div>
    </form>
</main>

<script>
    document.getElementById('categoryForm').addEventListener('submit', function(e) {
        const name = document.getElementById('name').value.trim();

        if (!name) {
            alert('Category name is required');
            e.preventDefault();
            return false;
        }
        if (name.length > 100) {
            alert('Category name must be 100 characters or less');
            e.preventDefault();
            return false;
        }
        return true;
    });
</script>

<%- include('partials/footer') %>